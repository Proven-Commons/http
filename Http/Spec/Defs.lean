import Http.Parse

namespace Http.Spec

/-- A line contains neither CR nor LF. This is the property itself, not an alias. -/
def NoBareLineBreak (bs : List UInt8) : Prop :=
  ∀ b, b ∈ bs → b ≠ 0x0D ∧ b ≠ 0x0A

inductive StreamFrames : List (RequestHead × List UInt8) → List UInt8 → List UInt8 → Prop where
  | nil (tail : List UInt8) : StreamFrames [] tail tail
  | cons {stream : List UInt8} {r : FramedRequest} {msgs : List (RequestHead × List UInt8)}
      {tail : List UInt8} :
      Http.parseRequest stream = some r →
      StreamFrames msgs tail r.rest →
      StreamFrames ((r.head, r.body) :: msgs) tail stream

